# === Data Paths ===
CHILDREN_PATH=chunked/children.json
PARENTS_PATH=chunked/parents.json
INDEX_DIR=faiss_index

# === Embedding Model ===
EMBEDDING_MODEL=BAAI/bge-m3
DEVICE=cpu
BATCH_SIZE=32

# === Retrieval Settings ===
TOP_K=3
SIMILARITY_THRESHOLD=0.35

# === API Keys (for future LLM integration) ===
OPENROUTER_API_KEY=sk-or-...
# or
OPENROUTER_MODEL=openrouter_model_name

